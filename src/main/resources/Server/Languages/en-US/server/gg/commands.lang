error= <color is="#f70000"><b>{message}</b></color>

# ==================== Sessions ====================
session.create.pending=<color is="#f7d600">Adding session {sessionId}...</color>
session.create.success=<color is="#4af700">Session {sessionId} added!</color>

session.list.line=/---<b><color is="#fbff00">{sessionId}</color></b>---\\\
                    \n<color is="#a2a2a2">Currnet Game:</color> <color is="#f7d600"><b>{game}</b></color>\
                    \n<color is="#a2a2a2">State:</color> {state}\
                    \n<color is="#a2a2a2">Game List:</color> <i>{gamesList}</i>\
                    \n\\---

session.add.success=<color is="#f7d600">Successfully added game {gameId} to {sessionId}</color>
session.remove.success=<color is="#f7d600">{status} removed game {gameId} from {sessionId}</color>

session.destroy.pending=<color is="#f7d600">Removing {sessionId} from registry...</color>
session.destroy.success=<color is="#4af700">Removed {sessionId} from registry</color>

session.setup.pending=<color is="#f7d600">Setting up {sessionId}</color>
session.setup.success=<color is="#4af700">Setup {gameId} in {sessionId}</color>

session.start.pending=<color is="#f7d600">Starting {sessionId}</color>
session.start.success=<color is="#4af700">Started {gameId} in {sessionId}</color>

session.stop.pending=<color is="#f7d600">Stopping {sessionId}</color>
session.stop.success=<color is="#4af700">Stopped {gameId} in {sessionId}</color>

session.cleanup.pending=<color is="#f7d600">Cleaning up game in {sessionId}...</color>

# ==================== Party ====================
party.invalidname = <b><color is="#ed7f77">{party}</color></b> is not a valid party name!

party.header = \n<color is="#ebcb94">======</color> <b>{name}</b> <color is="#ebcb94">======</color>
party.owner = <color is="#edd977"><i>{i}.</i> <b>{name}</b></color>
party.member = <color is="#edd977"><i>{i}.</i> {name}</color>

party.joined.you = You <color is="#77ed7d">joined</color> <b>{party}</b>!
party.joined = <b>{player}</b> <color is="#77ed7d">joined</color> your party!
party.left.you = You <color is="#ed7f77">left</color> <b>{party}</b>.
party.left = <b>{player}</b> <color is="#ed7f77">left</color> your party!

party.invite.leaderonly = Only the <b>party leader</b> can send party invites!
party.invite.declined.you = <color is="#ed7f77">Declined</color> invite to join <b>{party}</b>.
party.invite.declined = <b>{recipient}</b> <color is="#ed7f77">decline</color> your invite to join <b>{party}</b>.
party.invite.sent = Invited <b>{recipient}</b> to join {party}!\n<i>The invite will expire in {expiry}s</i>.
party.invite.received = \n<color is="#ebcb94">======</color> You have received a party invite from <b>{sender}</b>! <color is="#ebcb94">======</color>\n\\
                        Use <b>/party accept "{party}"</b> to <color is="#77ed7d">accept</color>.\n\\
                        Use <b>/party decline "{party}"</b> to <color is="#ed7f77">decline</color>.\n\
                        <color is="#ebcb94">======</color> The invite will expire in {expiry}s <color is="#ebcb94">======</color>